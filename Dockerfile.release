# Runtime image for goreleaser release builds (see .goreleaser.yaml `dockers`).
#
# Unlike the main Dockerfile, this does NOT compile: goreleaser cross-compiles
# the per-arch `ingot` binary and drops it into the build context, so this just
# packages it. Mirrors the main Dockerfile's `prod` target — debian slim +
# ca-certificates + curl (smelt's healthcheck hits /health with curl) — and
# keeps the bare ENTRYPOINT so the compose `command:` supplies `serve …`.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*
COPY ingot /usr/bin/ingot
# S3 listener. The binary defaults to :9000; the compose config binds :80 so
# did:web:ingot resolves to http://ingot:80/.well-known/did.json.
EXPOSE 80
ENTRYPOINT ["/usr/bin/ingot"]
